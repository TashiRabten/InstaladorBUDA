  "_tasks_comment": "Standalone commands that are not app releases (one-off utilities). runOn 'mac' commands cannot execute on Windows — InstaladorBUDA shows + copies them to paste into the Mac VM. runOn 'local' commands run in a console (or print under Dry run). cwdRepo names an app whose repoRoot is the working directory.",
  "tasks": [
    {
      "name": "Rebuild Tesseract Intel bundle  (run on your Intel Mac VM)",
      "runOn": "mac",
      "cwdRepo": "TradutorBUDA",
      "command": "bash scripts/build-tesseract-mac.sh --upload"
    },
    {
      "name": "Trigger Tesseract CI  (build arm64 + fetch Intel)",
      "runOn": "local",
      "cwdRepo": "TradutorBUDA",
      "command": "gh workflow run build-tesseract-portable.yml"
    }
  ]
